# Copy to .env next to docker-compose.yml. Never commit .env.
#
# The platform wiring (BACKEND_SLUG through PUBLIC_BASE_URL) is written by the
# platform host tool:
#   exb register frontend-itam --course frontend-itam --env-file "$PWD/.env"
# Fill in the rest yourself.

# Slug registered on the course platform. Also the URL segment and part of
# the container names.
BACKEND_SLUG=frontend-itam

# Loopback port, allocated by exb from 19100-19199.
BACKEND_PORT=19100

# Where the course platform API lives, with no trailing slash.
PLATFORM_API_URL=https://courses.salut.uno

# Shown only once, when exb registers the backend or rotates its key
# (`exb rotate-key`). Rotating kills the old value immediately.
PLATFORM_SERVICE_KEY=exbk_written_by_exb

# The absolute public URL of this API. It is used in the Swagger examples and as
# the OpenAPI server, so generated clients get the right base URL.
PUBLIC_BASE_URL=https://courses.salut.uno/example-backend/frontend-itam

# Course-team token for the /api/admin endpoints (X-Admin-Token header).
# Use a long random string. Leave it empty to disable the admin API.
ADMIN_TOKEN=replace_me_with_a_long_random_string

# Vote thresholds used until an admin changes them via PATCH /api/admin/settings.
DEFAULT_ACCEPT_THRESHOLD=5
DEFAULT_REJECT_THRESHOLD=5

# This stack's own database.
POSTGRES_DB=example_backend
POSTGRES_USER=example
POSTGRES_PASSWORD=replace_me
